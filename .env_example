# Required only by POST /analyze. GET /validate is pure regex and needs nothing.
# Without this set, /analyze returns HTTP 500 with a message saying so; the rest
# of the API still serves normally.
GEMINI_API_KEY=<your_api_key>

# Optional. The Gemini model /analyze calls. Defaults to gemini-3-flash-preview
# when unset, which is the value that was previously hardcoded.
# GEMINI_MODEL=gemini-3-flash-preview

# Set by the host in production (Railway injects it). Do not hardcode a value
# here -- the Procfile binds uvicorn to $PORT.
# PORT=8000
